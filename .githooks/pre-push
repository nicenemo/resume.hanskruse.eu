#!/usr/bin/env bash
# Pre-push hook: second secret scanner (trufflehog) over the commits that are about to be pushed, and a scan of the
# dependencies for known vulnerabilities (osv-scanner, needs network access).
# Enable with ./githooks-setup.sh. Verification contacts the providers of any key it finds.
set -euo pipefail

for tool in trufflehog osv-scanner; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "pre-push: $tool is not installed; refusing to push unscanned." >&2
        exit 1
    fi
done

# Scan only what the remote does not have yet; on the first push scan everything.
if git rev-parse --verify --quiet "@{upstream}" >/dev/null; then
    base="$(git rev-parse "@{upstream}")"
    trufflehog git "file://$PWD" --since-commit "$base" --branch HEAD --results=verified,unknown,unverified --fail >/dev/null
else
    trufflehog git "file://$PWD" --results=verified,unknown,unverified --fail >/dev/null
fi

# Known vulnerabilities in the dependencies (osv.dev). Exit code 128 means that there is no package source to scan,
# which is expected for a site without package manifests, and is not an error.
status=0
osv-scanner scan source --recursive . >/dev/null || status=$?
if [ "$status" -ne 0 ] && [ "$status" -ne 128 ]; then
    echo "pre-push: osv-scanner found vulnerable dependencies or failed (exit code $status); run it by hand." >&2
    exit "$status"
fi
